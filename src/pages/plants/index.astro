---
import BaseLayout from '../../../core/layouts/BaseLayout.astro';
import PlantGrid from '../../../core/components/PlantGrid.astro';
import { categories, plants } from '../../data/catalog';
import { client } from '../../../core/client';
const titleWords = client.copy.directoryTitle.trim().split(/\s+/);
const titleEmphasis = titleWords.pop();
const titleLead = titleWords.join(' ');
---

<BaseLayout title={`${client.copy.collectionPageTitle} | ${client.name}`} description={client.copy.collectionMeta.replace('{name}', client.name).replace('{location}', client.locality ? ` in ${client.locality}` : '')}>
  <main id="main" class:list={['section-wrap', client.layout === 'working-row-preview' && 'nasar-directory', client.headerStyle === 'wordmark' && 'usman-directory']}>
    <header class="page-heading">
      <p class="section-kicker">{client.copy.directoryKicker}</p>
      {client.layout === 'working-row-preview' ? <h1>{titleLead} <em>{titleEmphasis}</em></h1> : <h1>{client.copy.directoryTitle}</h1>}
      <p>{client.copy.directoryDescription}</p>
    </header>
    <PlantGrid plants={plants} filterCategories />
  </main>
</BaseLayout>

<style is:global>
  body:has(.nasar-directory){background:#e8efdd}
  .nasar-directory{position:relative;isolation:isolate;padding-bottom:55px;overflow-x:clip}
  .nasar-directory::before{content:'';position:absolute;z-index:-1;top:0;right:0;width:min(60%,560px);height:480px;background:linear-gradient(90deg,#e8efdd 2%,transparent 70%),linear-gradient(0deg,#e8efdd,transparent 70%),url('/categories-topiary.webp') center 38%/cover no-repeat;opacity:.68;pointer-events:none}
  .nasar-directory .page-heading{padding:75px 0 28px}.nasar-directory .page-heading h1{max-width:8ch;color:#132a1b;font-family:var(--sans);font-weight:700;line-height:.98;letter-spacing:-.055em}.nasar-directory .page-heading h1 em{display:block;color:#568e14;font-style:normal}.nasar-directory .page-heading>p:last-child{max-width:30ch;font-size:15px;line-height:1.5;color:#47594a}.nasar-directory .page-heading .section-kicker{color:#4c5d4c}
  .nasar-directory .plant-tools{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 20px;padding:16px;border-radius:26px;background:rgba(246,248,236,.78);border:1px solid rgba(255,255,255,.85);box-shadow:0 10px 30px #47613b20;backdrop-filter:blur(12px)}
  .nasar-directory .plant-search,.nasar-directory .plant-sort{min-width:0;width:100%;min-height:48px;border:0;border-radius:999px;background:#f7f8f2;color:#263e2b;font-size:14px}.nasar-directory .plant-search{grid-column:1/-1;padding:0 18px}.nasar-directory .plant-sort{padding:0 15px}.nasar-directory .result-count{grid-column:1;align-self:center;width:auto;margin:10px 0 0;font-size:13px;font-weight:700;color:#38652f}
  .nasar-directory .view-switch{grid-column:2;justify-self:end;display:flex;gap:2px;margin-top:10px;padding:3px;border-radius:13px;background:#e4eadb}.nasar-directory .view-switch button{display:grid;place-items:center;width:38px;height:34px;border:0;border-radius:10px;background:transparent;color:#263e2b;cursor:pointer}.nasar-directory .view-switch button[aria-pressed=true]{color:white;background:#234a2d}.nasar-directory .view-switch svg{width:18px;height:18px}
  .nasar-directory .plant-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding-bottom:35px}.nasar-directory .plant-card{position:relative;display:block;min-width:0;overflow:hidden;aspect-ratio:4/5;border-radius:18px;background:#1d3c27}.nasar-directory .plant-card-image{position:absolute;inset:0;aspect-ratio:auto;border-radius:0}.nasar-directory .plant-card-image img{display:block;object-fit:cover}.nasar-directory .plant-card-details{position:absolute;inset:auto 0 0;display:flex;flex-direction:column;gap:3px;min-height:44%;justify-content:end;padding:38px 13px 14px;color:white;background:linear-gradient(0deg,rgba(9,35,18,.97),rgba(9,35,18,.77) 46%,transparent)}.nasar-directory .plant-card-details>span:first-child{gap:3px}.nasar-directory .plant-card-details strong{color:white;font-family:var(--sans);font-size:15px;line-height:1.2;font-weight:700;overflow-wrap:anywhere}.nasar-directory .plant-card-category,.nasar-directory .plant-price{color:#e3eddd;font-size:11px}.nasar-directory .plant-card:hover .plant-card-image img,.nasar-directory .plant-card:focus-visible .plant-card-image img{filter:none}.nasar-directory .plant-card-mark{display:none}.nasar-directory .plant-card[hidden]{display:none}
  .nasar-directory .plant-grid.is-list{grid-template-columns:1fr}.nasar-directory .plant-grid.is-list .plant-card{aspect-ratio:auto;height:140px}.nasar-directory .plant-grid.is-list .plant-card-image{width:42%}.nasar-directory .plant-grid.is-list .plant-card-details{inset:0 0 0 42%;min-width:0;min-height:0;padding:16px 18px;justify-content:center;background:#193d25}
  @media(min-width:701px){.nasar-directory .plant-tools{grid-template-columns:2fr 1fr 1fr auto auto}.nasar-directory .plant-search{grid-column:auto}.nasar-directory .result-count{grid-column:auto;margin:0}.nasar-directory .view-switch{grid-column:auto;margin:0}.nasar-directory .plant-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.nasar-directory .page-heading{padding-top:95px}}
  @media(max-width:700px){.nasar-directory{width:calc(100% - 32px);max-width:100%;overflow-x:clip}.nasar-directory::before{right:0;width:min(82%,360px);height:360px;opacity:.48}.nasar-directory .page-heading{padding:62px 0 24px}.nasar-directory .page-heading h1{max-width:11ch;font-size:clamp(36px,10vw,48px);overflow-wrap:anywhere}.nasar-directory .page-heading>p:last-child{max-width:34ch;font-size:14px}.nasar-directory .plant-tools{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:9px;padding:13px;border-radius:22px}.nasar-directory .plant-sort{min-width:0;padding:0 11px;font-size:13px}.nasar-directory .plant-grid{gap:14px 12px}.nasar-directory .plant-card{aspect-ratio:.83;border-radius:16px}.nasar-directory .plant-card-details{padding:32px 10px 12px}.nasar-directory .plant-card-details strong{font-size:clamp(13px,3.8vw,15px)}.nasar-directory .plant-card-category,.nasar-directory .plant-price{font-size:11px}.nasar-directory .plant-grid.is-list .plant-card{height:clamp(112px,34vw,140px)}.nasar-directory .plant-grid.is-list .plant-card-image{width:40%}.nasar-directory .plant-grid.is-list .plant-card-details{inset:0 0 0 40%;padding:12px}.nasar-directory .plant-grid{padding-bottom:90px}body:has(.nasar-directory) .whatsapp-float{display:none}}
  @media(max-width:359px){.nasar-directory .plant-grid{grid-template-columns:minmax(0,1fr);max-width:320px;margin-inline:auto}.nasar-directory .plant-card{aspect-ratio:1.05}.nasar-directory .plant-card-details{padding:40px 15px 15px}.nasar-directory .plant-card-details strong{font-size:16px}}
  @media(max-width:700px){body:has(.usman-directory){background-color:#e8efdd;background-image:linear-gradient(90deg,rgba(232,239,221,.93) 2%,rgba(232,239,221,.52) 70%),linear-gradient(0deg,#e8efdd,transparent 70%),url('/categories-topiary.webp');background-position:center top;background-size:100% 460px;background-repeat:no-repeat}.nasar-directory.usman-directory{width:100%;padding-inline:16px}.nasar-directory.usman-directory::before{display:none}}
</style>
