---
import BaseLayout from '../../../core/layouts/BaseLayout.astro';
import PlantGrid from '../../../core/components/PlantGrid.astro';
import { categories, plants } from '../../data/catalog';
import { client } from '../../../core/client';
---

<BaseLayout title={`Plant collections | ${client.name}`} description={`Browse plant collections from ${client.name} in ${client.locality}.`}>
  <main id="main" class="section-wrap">
    <header class="page-heading">
      <p class="section-kicker">The plant directory</p>
      <h1>Explore the collections.</h1>
      <p>Explore our plant collections and find the plants you are looking for.</p>
    </header>
    <PlantGrid plants={plants} filterCategories />
  </main>
</BaseLayout>
