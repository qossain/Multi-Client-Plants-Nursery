---
import BaseLayout from '../../core/layouts/BaseLayout.astro';
import { client } from '../../core/client';
---

<BaseLayout title={`Page not found | ${client.name}`} description="The page could not be found.">
  <main id="main" class="not-found section-wrap">
    <h1>We could not find that page.</h1>
    <p>Explore the nursery collections or return to the home page.</p>
    <a class="button button-dark" href="/plants/"><span>Browse plant collections</span></a>
  </main>
</BaseLayout>
